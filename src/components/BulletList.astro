---
import { t } from '../i18n/locale';
import { site, WIP_HREF } from '../data/site';
export type BulletItem = { title: string; href: string; meta?: string; venue?: string; year?: string | number; external?: boolean };
interface Props { items: BulletItem[] }
const { items } = Astro.props;
---
{items.length > 0 && <ul class="bullet-list">{items.map(item => {
 const metadata = item.meta ?? item.venue;
 return <li class="bullet-list_item">
 {item.href === WIP_HREF ? <span>{item.title} <small class="bullet-list_meta">({t(site.ui.inPreparation)})</small></span> : <a href={item.href} class="bullet-list_link" target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.title}</a>}
 {metadata && <span class="bullet-list_meta"> ({metadata})</span>}
</li>;
})}</ul>}
