---
import { locale } from '../i18n/locale';
export type BulletItem = { title: string; href: string; venue?: string; year?: string | number; external?: boolean };
interface Props { items: BulletItem[] }
const { items } = Astro.props;
---
{items.length > 0 && <ul class="bullet-list">{items.map(item => <li class="bullet-list_item">
 {item.href === '/wip/' ? <span>{item.title} <small class="bullet-list_meta">({locale === 'en' ? 'In preparation' : '整理中'})</small></span> : <a href={item.href} class="bullet-list_link" target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.title}</a>}
 {(item.venue || item.year) && <span class="bullet-list_meta"> ({[item.venue, item.year].filter(Boolean).join(', ')})</span>}
</li>)}</ul>}
