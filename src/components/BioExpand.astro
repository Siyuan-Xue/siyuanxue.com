---
import RomanticPortrait from './RomanticPortrait.astro';
import { site } from '../data/site';

const { lead, more } = site.bio;
const paragraphs = [lead, ...more];
---

<section class="bio">
	<RomanticPortrait />

	<div class="bio-copy">
		{paragraphs.map((para, i) => (
			<p class:list={[i === 0 ? 'bio-lead' : 'bio-para']}>
				<span class="i18n-en" lang="en">
					{para.en}
				</span>
				<span class="i18n-zh" lang="zh-CN">
					{para.zh}
				</span>
			</p>
		))}
	</div>
</section>
