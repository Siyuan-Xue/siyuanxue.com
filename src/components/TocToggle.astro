---
import { t } from '../i18n/locale';
import { site } from '../data/site';
import { Menu, X } from '@lucide/astro';
---
<button type="button" class="header-control-button toc-toggle" data-toc-toggle data-open-label={t(site.ui.openContents)} data-close-label={t(site.ui.closeContents)} hidden aria-expanded="false" aria-controls="site-toc" aria-label={t(site.ui.openContents)} title={t(site.ui.openContents)}>
 <Menu class="toc-toggle-menu" size={20} stroke-width={1.8} aria-hidden="true" />
 <X class="toc-toggle-close" size={20} stroke-width={1.8} aria-hidden="true" />
</button>
