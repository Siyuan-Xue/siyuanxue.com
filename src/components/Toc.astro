---
import type { MarkdownHeading } from 'astro';
import { locale } from '../i18n/locale';
import TocList from './TocList.astro';
import '../styles/toc.css';
interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
const label = locale === 'en' ? 'Contents' : '目录';
---
<nav id="site-toc" class="toc-container" aria-labelledby="toc-title">
 <h2 id="toc-title" class="toc-title">{label}</h2>
 <TocList headings={headings} />
</nav>
<script>
 import { bindToc } from '../utils/toc';
 bindToc(document);
</script>
