---
import { locale, counterpartUrl } from '../i18n/locale';
---
<a class="header-control-button lang-toggle" href={counterpartUrl(locale, Astro.url.pathname)} lang={locale === 'en' ? 'zh-CN' : 'en'} hreflang={locale === 'en' ? 'zh-CN' : 'en'} aria-label={locale === 'en' ? 'Switch to Chinese' : '切换到英文'}>{locale === 'en' ? '中' : 'EN'}</a>
