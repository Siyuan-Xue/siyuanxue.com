---
import { Languages } from '@lucide/astro';
import { locale, counterpartUrl } from '../i18n/locale';
const label = locale === 'en' ? 'Switch to Chinese' : '切换到英文';
---
<a class="header-control-button lang-toggle" href={counterpartUrl(locale, Astro.url.pathname)} hreflang={locale === 'en' ? 'zh-CN' : 'en'} aria-label={label} title={label}>
 <Languages class="lang-toggle_icon" size={18} stroke-width={1.8} aria-hidden="true" />
</a>
