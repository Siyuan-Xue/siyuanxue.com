---
import ThemeToggle from './ThemeToggle.astro';
import { House, MessageCircleMore } from '@lucide/astro';
import TocToggle from './TocToggle.astro';
import { site } from '../data/site';
import { t } from '../i18n/locale';
interface Props { showTocToggle?: boolean }
const { showTocToggle = false } = Astro.props;
const chatLabel = t({ en: 'Chat with xue', zh: '与小薛聊聊' });
const homeLabel = t({ en: 'Home', zh: '首页' });
const isChat = Astro.url.pathname === '/chat/' || Astro.url.pathname === '/chat';
const isHome = Astro.url.pathname === '/';
const Brand = isHome ? 'h1' : 'span';
---
<header class="header"><div class="container cc-narrow header-inner">
 <a href="/" class="header-name-link" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}><Brand class="header-name">{t(site.name)}</Brand></a>
 <div class="header-controls">
  {!isHome && <a class="header-control-button header-home-link" href="/" aria-label={homeLabel} title={homeLabel}><House size={18} stroke-width={1.8} aria-hidden="true" /></a>}
  {!isChat && <a class="header-control-button header-chat-link" href="/chat/" aria-label={chatLabel} title={chatLabel}><MessageCircleMore size={18} stroke-width={1.8} aria-hidden="true" /></a>}
  {showTocToggle && <TocToggle />}
  <ThemeToggle />
 </div>
</div></header>
