---
import GalleryImageGrid from './GalleryImageGrid.astro';
import type { GalleryData } from '../utils/gallery';
import { t } from '../i18n/locale';
import { site } from '../data/site';
import '../styles/gallery.css';

type Props = Pick<GalleryData, 'title' | 'description' | 'period' | 'role' | 'layout' | 'images' | 'imageSections' | 'links' | 'videos' | 'videoTitle' | 'videoLayout' | 'videoDescription' | 'comparison'>;
const { title, description, period, role, layout = 'photos', images, imageSections = [], links, videos = [], videoTitle, videoLayout = 'comparison', videoDescription, comparison } = Astro.props;
const showVideoTitle = videoTitle !== null;
const demoLayout = videoLayout === 'demos';
---
<article class="gallery-page" data-gallery-page>
 <header class="gallery-header">
  <h1 class="post-title">{title}</h1>
  {period && <p class="gallery-period">{period}</p>}
  <p class="gallery-role"><span>{t(site.gallery.role)}:</span> {role}</p>
  <p class="gallery-description">{description}</p>
 </header>
 {videos.length > 0 && <section class:list={['gallery-videos', { 'gallery-videos-demos': demoLayout }]}
  aria-labelledby={showVideoTitle ? 'gallery-videos-heading' : undefined}
  aria-label={showVideoTitle ? undefined : t(site.gallery.videos)}>
  {showVideoTitle && <h2 id="gallery-videos-heading">{videoTitle ?? t(site.gallery.simulationResults)}</h2>}
  {videoDescription && <p>{videoDescription}</p>}
  <div class:list={['gallery-video-grid', { 'gallery-video-demos': videoLayout === 'demos' }]}>
   {videos.map(video => <figure class="gallery-figure">
    {!demoLayout && (showVideoTitle ? <h3>{video.label}</h3> : <h2>{video.label}</h2>)}
    <video controls playsinline preload="metadata" poster={video.poster.cover.src}
     width={video.poster.width} height={video.poster.height} aria-label={`${title} · ${video.label}`}>
     <source src={video.src.src} type={`video/${video.src.format === 'mov' ? 'quicktime' : video.src.format}`} />
     {t(site.gallery.videoFallback)}
    </video>
    <figcaption>{video.caption}<a class="gallery-video-download" href={video.src.src} download
     aria-label={`${t(site.gallery.downloadVideo)}: ${video.label}`}>{t(site.gallery.downloadVideo)}</a></figcaption>
   </figure>)}
  </div>
 </section>}
 {comparison && <h2 class="gallery-results-heading">{t(site.gallery.realRobot)}</h2>}
 {imageSections.length > 0 ? imageSections.map((section, index) => <section class="gallery-photo-section" aria-labelledby={`gallery-photo-heading-${index}`}>
  <h2 id={`gallery-photo-heading-${index}`}>{section.title}</h2>
  <GalleryImageGrid images={images.slice(section.start, imageSections[index + 1]?.start)} layout={layout} offset={section.start} />
 </section>) : <GalleryImageGrid images={images} layout={layout} />}
 {comparison && <section class="gallery-comparison" aria-label={comparison.title}>
  <p>{comparison.description}</p>
 </section>}
 {links.length > 0 && <section class="gallery-links" aria-labelledby="gallery-links-heading">
  <h2 id="gallery-links-heading">{t(site.gallery.related)}</h2>
  <ul>{links.map(link => <li><a href={link.href} rel="noopener noreferrer">{link.label}</a></li>)}</ul>
 </section>}
</article>
<script>
 import { bindGalleryLightbox } from '../utils/galleryLightbox';
 for (const root of document.querySelectorAll<HTMLElement>('[data-gallery-page]')) bindGalleryLightbox(root);
</script>
