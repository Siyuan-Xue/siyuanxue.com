---
import { site } from '../data/site';
import { locale, localeOrigin, t } from '../i18n/locale';
import '../styles/base.css';
import 'site-fonts';
import themeScript from '../scripts/theme.js?raw';
import type { ShareImage, GalleryMetadataImage, GalleryMetadataVideo } from '../utils/pageMetadata';
import { imageMedia } from '../utils/media';
interface Props { title?: string; description?: string; articleDate?: Date; noindex?: boolean; shareImage?: ShareImage; galleryImages?: GalleryMetadataImage[]; galleryVideos?: GalleryMetadataVideo[] }
const { title = t(site.title), description = t(site.description), articleDate, noindex = false, shareImage, galleryImages, galleryVideos } = Astro.props;
const canonical = new URL(Astro.url.pathname, localeOrigin(locale)).href;
const defaultCover = imageMedia(`share-${locale}`);
const cover = shareImage ?? { src: defaultCover.src, width: defaultCover.width, height: defaultCover.height, alt: t(site.name) };
const image = new URL(cover.src, localeOrigin(locale)).href;
const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? t(site.homeTitle) : `${title} — ${t(site.name)}`;
const language = locale === 'zh' ? 'zh-CN' : 'en';
const person = {
 '@type': 'Person', '@id': `${localeOrigin('en')}/#person`,
 name: t(site.name), alternateName: [locale === 'zh' ? site.name.en : site.name.zh, 'Miles'],
 url: `${localeOrigin('en')}/`, sameAs: [site.github, `${localeOrigin('zh')}/`],
};
const schema = galleryImages?.length
 ? {
  '@context': 'https://schema.org', '@type': 'ImageGallery', name: title, description,
  url: canonical, inLanguage: language, author: person, about: person,
  primaryImageOfPage: { '@type': 'ImageObject', contentUrl: image, width: cover.width, height: cover.height, description: cover.alt },
  image: galleryImages.map(photo => ({
   '@type': 'ImageObject', contentUrl: new URL(photo.src, localeOrigin(locale)).href,
   width: photo.width, height: photo.height, description: photo.alt, caption: photo.caption,
  })),
  ...(galleryVideos?.length ? { video: galleryVideos.map(video => ({
   '@type': 'VideoObject', name: video.name, description: video.description,
   contentUrl: new URL(video.src, localeOrigin(locale)).href,
   thumbnailUrl: new URL(video.poster, localeOrigin(locale)).href,
   duration: `PT${video.duration}S`, uploadDate: video.uploadDate,
  })) } : {}),
 }
 : articleDate
 ? { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description, datePublished: articleDate.toISOString(), author: person, inLanguage: language, mainEntityOfPage: canonical, url: canonical, image }
 : isHome ? {
  '@context': 'https://schema.org',
  '@graph': [
   { '@type': 'ProfilePage', '@id': `${canonical}#profile`, url: canonical, name: fullTitle, description, inLanguage: language, mainEntity: person },
   { '@type': 'WebSite', '@id': `${canonical}#website`, url: canonical, name: t(site.name), alternateName: locale === 'zh' ? site.name.en : site.name.zh, inLanguage: language, publisher: { '@id': person['@id'] } },
  ],
 } : undefined;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#f0eee6" data-light="#f0eee6" data-dark="#1f1e1d" />
<meta name="color-scheme" content="light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname, localeOrigin('en'))} />
<link rel="alternate" hreflang="zh-CN" href={new URL(Astro.url.pathname, localeOrigin('zh'))} />
<link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, localeOrigin('en'))} />
<link rel="alternate" type="application/rss+xml" title={t(site.title)} href="/rss.xml" />
<meta property="og:type" content={articleDate ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
<meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(cover.width)} /><meta property="og:image:height" content={String(cover.height)} />
<meta property="og:image:alt" content={cover.alt} />
{articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={cover.alt} />
<meta name="generator" content={Astro.generator} />
{schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
<script is:inline set:html={themeScript} />
