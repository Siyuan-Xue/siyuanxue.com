---
import { site } from '../data/site';
import { languageTag, locale, localeOrigin, t } from '../i18n/locale';
import '../styles/base.css';
import 'site-fonts';
import themeScript from '../scripts/theme.js?raw';
import themeColors from '../styles/theme-colors.css?raw';
import { inlineThemeScript } from '../utils/themeHint';
import { imageMedia } from '../utils/media';
import { getDiscoveryPage } from '../utils/discoveryContent';
const page = await getDiscoveryPage(Astro.url.pathname);
const { title, description, structuredDescription, canonical, fullTitle, shareImage } = page;
const noindex = !page.indexable;
const articleDate = (page.kind === 'essay' || page.kind === 'post') && page.datePublished ? new Date(page.datePublished) : undefined;
const galleryImages = page.kind === 'gallery' ? page.images : undefined;
const galleryVideos = page.kind === 'gallery' ? page.videos : undefined;
const defaultCover = imageMedia(`share-${locale}`);
const cover = shareImage ?? { src: defaultCover.src, width: defaultCover.width, height: defaultCover.height, alt: t(site.name) };
const image = new URL(cover.src, localeOrigin(locale)).href;
const isHome = Astro.url.pathname === '/';
const baiduSiteVerification = locale === 'zh' && isHome ? process.env.BAIDU_SITE_VERIFICATION_ZH?.trim() : undefined;
const language = languageTag();
const person = {
 '@type': 'Person', '@id': `${localeOrigin('en')}/#person`,
 name: t(site.name), alternateName: [locale === 'zh' ? site.name.en : site.name.zh, 'Miles'],
 url: `${localeOrigin('en')}/`, sameAs: [site.github, `${localeOrigin('zh')}/`],
 description: t(site.bio.lead),
 image: new URL(imageMedia('portrait').src, localeOrigin('en')).href,
 knowsAbout: ['AI systems', 'AI agents', 'Full-stack engineering'],
};
const schema = galleryImages?.length
 ? {
  '@context': 'https://schema.org', '@type': 'ImageGallery', '@id': `${canonical}#gallery`, name: title, description: structuredDescription,
  url: canonical, inLanguage: language, author: person, about: person,
  isPartOf: { '@id': `${localeOrigin(locale)}/#website` },
  ...(page.datePublished ? { datePublished: page.datePublished } : {}),
  ...(page.dateModified ? { dateModified: page.dateModified } : {}),
  primaryImageOfPage: { '@type': 'ImageObject', contentUrl: image, width: cover.width, height: cover.height, description: cover.alt },
  image: galleryImages.map(photo => ({
   '@type': 'ImageObject', '@id': new URL(photo.src, localeOrigin(locale)).href, contentUrl: new URL(photo.src, localeOrigin(locale)).href,
   width: photo.width, height: photo.height, description: photo.alt, caption: photo.caption,
   isPartOf: { '@id': `${canonical}#gallery` },
  })),
  ...(galleryVideos?.length ? { video: galleryVideos.map(video => ({
   '@type': 'VideoObject', '@id': new URL(video.src, localeOrigin(locale)).href, name: video.name, description: video.description,
   contentUrl: new URL(video.src, localeOrigin(locale)).href,
   thumbnailUrl: new URL(video.poster, localeOrigin(locale)).href,
   ...(video.duration ? { duration: `PT${video.duration}S` } : {}), ...(video.uploadDate ? { uploadDate: video.uploadDate } : {}),
   isPartOf: { '@id': `${canonical}#gallery` },
  })) } : {}),
 }
 : articleDate
 ? { '@context': 'https://schema.org', '@type': 'BlogPosting', '@id': `${canonical}#article`, headline: title, description: structuredDescription, datePublished: articleDate.toISOString(), ...(page.dateModified ? { dateModified: page.dateModified } : {}), author: person, publisher: { '@id': person['@id'] }, inLanguage: language, mainEntityOfPage: canonical, isPartOf: { '@id': `${localeOrigin(locale)}/#website` }, url: canonical, image }
 : isHome ? {
  '@context': 'https://schema.org',
  '@graph': [
   { '@type': 'ProfilePage', '@id': `${canonical}#profile`, url: canonical, name: fullTitle, description: structuredDescription, inLanguage: language, mainEntity: person },
   { '@type': 'WebSite', '@id': `${canonical}#website`, url: canonical, name: t(site.name), alternateName: locale === 'zh' ? site.name.en : site.name.zh, inLanguage: language, publisher: { '@id': person['@id'] } },
  ],
 } : undefined;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<!-- System colors are available to the parser, including when scripting is off. -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f0eee6" data-light="#f0eee6" data-dark="#1f1e1d" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1f1e1d" />
<meta name="color-scheme" content="light dark" />
<style is:inline set:html={themeColors} />
<script is:inline set:html={inlineThemeScript(themeScript)} />
<!-- With scripting disabled, expose the real navigation links before first paint. -->
<noscript><style is:global>
 .header-controls .header-actions-panel { max-width: none; opacity: 1; transform: none; visibility: visible; overflow: visible; }
 .header-controls .header-actions-row > * { opacity: 1; transform: none; }
 .header-controls :is(button, .header-actions-toggle) { display: none; }
 @media (max-width: 767px) {
  .header .header-inner { display: flex; gap: 0; }
 }
</style></noscript>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{baiduSiteVerification && <meta name="baidu-site-verification" content={baiduSiteVerification} />}
{noindex && <meta name="robots" content="noindex, follow" />}
{page.kind === 'redirect' && <>
 <meta http-equiv="refresh" content={`0;url=${new URL(canonical).pathname}`} />
 <script is:inline>
  // Carry an in-memory choice through the legacy same-origin redirect too.
  // Run immediately after the refresh meta, before its navigation can start.
  (() => {
   const refresh = document.querySelector('meta[http-equiv="refresh"]');
   if (refresh && window.__siteTheme) refresh.content = `0;url=${window.__siteTheme.hintHref(refresh.content.slice('0;url='.length))}`;
  })();
 </script>
</>}
<link rel="canonical" href={canonical} />
{Object.entries(page.alternates).map(([language, url]) => <link rel="alternate" hreflang={language} href={url} />)}
<link rel="alternate" type="application/rss+xml" title={t(site.title)} href="/rss.xml" />
<meta property="og:type" content={articleDate ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
<meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(cover.width)} /><meta property="og:image:height" content={String(cover.height)} />
<meta property="og:image:alt" content={cover.alt} />
{articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
{articleDate && page.dateModified && <meta property="article:modified_time" content={page.dateModified} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={cover.alt} />
<meta name="generator" content={Astro.generator} />
{schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
