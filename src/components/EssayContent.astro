---
import type { CollectionEntry } from 'astro:content';
import MediaPicture from './MediaPicture.astro';
import { splitEssayFigures } from '../utils/essayFigures';
interface Props { figures: CollectionEntry<'essay'>['data']['figures'] }
const blocks = splitEssayFigures(await Astro.slots.render('default') ?? '', Astro.props.figures);
---
{blocks.map(block => block.type === 'html' ? <Fragment set:html={block.html} /> : (
 <figure class="essay-figure">
  <a href={block.figure.src.src} aria-describedby={`essay-figure-${block.figure.id}-caption`}>
   <MediaPicture asset={block.figure.src} alt={block.figure.alt} sizes="(max-width: 479px) calc(100vw - 40px), (max-width: 991px) calc(80vw - 20px), 580px" />
  </a>
  <figcaption id={`essay-figure-${block.figure.id}-caption`}>{block.figure.caption}</figcaption>
 </figure>
))}
<style>
 .essay-figure a, .essay-figure :global(picture), .essay-figure :global(img) { display: block; }
 .essay-figure :global(img) { width: 100%; height: auto; }
 .essay-figure a:is(:hover, :focus-visible) { outline: 2px solid var(--fg-interactive); outline-offset: 4px; }
</style>
