---
import LoadingBlocks from './LoadingBlocks.astro';
import { site } from '../data/site';
import { t } from '../i18n/locale';
import { Picture } from 'astro:assets';
import portraitImage from '../assets/portrait.jpg';
import { X } from '@lucide/astro';
import '../styles/romantic.css';

const portrait = site.portrait;
const secret = site.secretPortrait;
const captionId = 'romantic-mode-caption';
---

<div
	class="bio-portrait romantic-portrait"
	data-romantic-mode
	data-romantic-lightbox
	data-secret-src={secret.src}
	data-secret-width={secret.width}
	data-secret-height={secret.height}
	data-primary-alt={t(portrait.alt)}
	data-secret-alt={t(secret.alt)}
	data-dialog-label={t(secret.dialogLabel)}
	data-close-label={t(secret.closeLabel)}
	data-caption={secret.caption.en}
	data-proof-label="PORTRAIT STUDY"
 data-load-error={t({ en: 'The image could not be loaded. Please try again.', zh: '图片加载失败，请重试。' })}
	data-turn-on-label={t(secret.turnOnLabel)}
	data-turn-off-label={t(secret.turnOffLabel)}
	data-mode-on={t(secret.modeOnMessage)}
	data-mode-off={t(secret.modeOffMessage)}
>
	<template data-lightbox-close-icon><span aria-hidden="true"><X size={18} stroke-width={1.8} /></span></template>
	{/*
	  Portrait stage: md blocks, faint tone over soft veil — sits in the float column.
	  The secret card keeps the same loader pattern at md.
	*/}
	<div
		class="romantic-portrait_stage loading-slot"
		style={`--romantic-portrait-aspect: ${portrait.width} / ${portrait.height}`}
		data-primary-loading-slot
	>
		<span class="loading-slot_indicator loading-slot_indicator--veil" data-primary-loader>
			<LoadingBlocks size="md" tone="faint" decorative />
		</span>
		<button
			type="button"
			class="romantic-portrait_primary"
			data-romantic-trigger
			aria-controls="romantic-secret-card"
			aria-expanded="false"
			aria-label={t(secret.turnOnLabel)}
		>
			<Picture
				class="bio-portrait_img romantic-portrait_image"
				src={portraitImage}
				alt={t(portrait.alt)}
				width={960}
				widths={[320, 640, 960]}
				formats={['avif', 'webp']}
				sizes="(max-width: 480px) min(46vw, calc(100vw - 12rem), 12rem), 192px"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				data-primary-image
			/>
		</button>

		<a
			id="romantic-secret-card"
			class="romantic-portrait_secret loading-slot"
			href={secret.src}
			aria-label={t(secret.dialogLabel)}
			aria-describedby={captionId}
			data-secret-card
			data-romantic-lightbox-trigger
			data-pswp-width={secret.width}
			data-pswp-height={secret.height}
			hidden
		>
			<span class="loading-slot_indicator loading-slot_indicator--veil" data-secret-loader>
				<LoadingBlocks size="md" tone="faint" decorative />
			</span>
			<span class="romantic-portrait_secret-media" data-secret-image-slot></span>
		</a>
	</div>

	<p
		class="romantic-mode_toast"
		role="status"
		aria-live="polite"
		aria-atomic="true"
		data-romantic-status
	></p>

	<p id={captionId} class="u-sr-only" lang="en" data-romantic-lightbox-description>
		{secret.caption.en}
	</p>
</div>

<script>
 import { initRomanticPortraitController } from '../utils/romanticPortraitController';
 document.querySelectorAll<HTMLElement>('[data-romantic-mode]').forEach(initRomanticPortraitController);
</script>
