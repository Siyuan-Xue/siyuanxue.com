---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { languageTag, locale } from '../i18n/locale';
interface Props { htmlClass?: string; showTocToggle?: boolean; hasToc?: boolean }
const { htmlClass = '', showTocToggle = false, hasToc = false } = Astro.props;
---
<!doctype html>
<html id="top" lang={languageTag()} data-lang={locale} class={htmlClass}>
 <head><BaseHead /></head>
 <body class:list={[hasToc && 'has-toc']}>
  <div class="page-wrapper">
   <Header showTocToggle={showTocToggle} />
   <slot name="toc" />
   <main class="page-main"><slot /></main>
  </div>
 </body>
</html>
