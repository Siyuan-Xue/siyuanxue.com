---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { locale } from '../i18n/locale';
import type { ShareImage, GalleryMetadataImage, GalleryMetadataVideo } from '../utils/pageMetadata';
interface Props { title?: string; description?: string; htmlClass?: string; showTocToggle?: boolean; hasToc?: boolean; articleDate?: Date; noindex?: boolean; showHeader?: boolean; shareImage?: ShareImage; galleryImages?: GalleryMetadataImage[]; galleryVideos?: GalleryMetadataVideo[] }
const { title, description, htmlClass = '', showTocToggle = false, hasToc = false, articleDate, noindex, showHeader = true, shareImage, galleryImages, galleryVideos } = Astro.props;
---
<!doctype html>
<html id="top" lang={locale === 'zh' ? 'zh-CN' : 'en'} data-lang={locale} class={htmlClass}>
 <head><BaseHead title={title} description={description} articleDate={articleDate} noindex={noindex} shareImage={shareImage} galleryImages={galleryImages} galleryVideos={galleryVideos} /></head>
 <body class:list={[hasToc && 'has-toc']}>
  <div class="page-wrapper">
   {showHeader && <Header showTocToggle={showTocToggle} />}
   <slot name="toc" />
   <main class="page-main"><slot /></main>
  </div>
 </body>
</html>
