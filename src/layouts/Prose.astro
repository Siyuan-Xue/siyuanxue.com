---
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import { site } from '../data/site';
import { t } from '../i18n/locale';
import { formatDate } from '../utils/content';
import { tocHeadings } from '../utils/toc';
import type { MarkdownHeading } from 'astro';
interface Props { title: string; subtitle?: string; description: string; date: Date; headings: MarkdownHeading[] }
const { title, subtitle, description, date, headings } = Astro.props;
const items = tocHeadings(headings);
---
<Base title={title} description={description} articleDate={date} showTocToggle={items.length > 0} hasToc={items.length > 0}>
 {items.length > 0 && <Toc slot="toc" headings={items} />}
 <article><div class="container cc-narrow"><header class="post-header"><h1 class="post-title">{title}</h1>{subtitle && <p class="post-subtitle">{subtitle}</p>}<p class="post-date"><time datetime={date.toISOString()}>{formatDate(date)}</time></p></header><div id="main-content" class="prose" data-toc-contents><slot /></div><a href="#top" class="back-to-top">{t(site.ui.backToTop)}</a></div></article>
</Base>
