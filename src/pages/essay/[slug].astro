---
import Prose from '../../layouts/Prose.astro';
import EssayContent from '../../components/EssayContent.astro';
import { render } from 'astro:content';
import { getEssays } from '../../utils/content';
export async function getStaticPaths() { return (await getEssays()).map(({ slug, entry }) => ({ params: { slug }, props: { entry } })); }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Prose {...entry.data} headings={headings}><EssayContent figures={entry.data.figures}><Content /></EssayContent></Prose>
