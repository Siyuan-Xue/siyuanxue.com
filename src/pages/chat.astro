---
import Base from '../layouts/Base.astro';
import { ChatApp, type ChatCopy } from '../components/chat/ChatApp';
import { t, locale } from '../i18n/locale';
import { site } from '../data/site';

const copy: ChatCopy = {
  title: t({ en: 'Chat with xue', zh: '与小薛聊聊' }),
  name: t({ en: 'xue', zh: '小薛' }),
  welcome: t({ en: 'Good to meet you. I’m xue.', zh: '见面愉快，我是小薛。' }),
  intro: t({ en: `I’m ${t(site.name)}’s AI assistant—he’s my Boss. Welcome! Ask about his projects and writing, or just stay for a chat. A little wit comes with the welcome.`, zh: `我是${t(site.name)}的 AI 助手，他是我的 Boss。聊项目、读文章，或者随便坐坐——正经介绍，偶尔贫嘴。` }),
  label: t({ en: 'Your message', zh: '你的消息' }), placeholder: t({ en: 'What’s on your mind?', zh: '今天想聊点什么？' }),
  identity: t({ en: 'xue · Here to chat', zh: '小薛 · 随时聊聊' }), send: t({ en: 'Send message', zh: '发送消息' }),
  stop: t({ en: 'Stop reply', zh: '停止回复' }),
  busy: t({ en: 'xue is replying…', zh: '小薛正在回复…' }), you: t({ en: 'You', zh: '你' }),
  copy: t({ en: 'Copy answer', zh: '复制回复' }), codeCopy: t({ en: 'Copy code', zh: '复制代码' }), copied: t({ en: 'Copied.', zh: '已复制。' }),
  copyFailed: t({ en: 'Could not copy. Select the text and copy it manually.', zh: '复制失败，请选中文字手动复制。' }),
  retry: t({ en: 'Try again', zh: '再试一次' }), returnToBottom: t({ en: 'Return to latest message', zh: '回到最新消息' }),
  inputHint: t({ en: 'Enter to send · Shift + Enter for a new line', zh: 'Enter 发送 · Shift + Enter 换行' }),
  mobileInputHint: t({ en: 'Use the send button · Enter makes a new line', zh: '点击发送按钮 · Enter 换行' }),
  stopped: t({ en: 'Reply stopped. What arrived is saved.', zh: '回复已停止，已收到的内容会保留。' }),
  interrupted: t({ en: 'Reply interrupted. What arrived is saved; you can try again.', zh: '回复中断了，已收到的内容会保留，可以再试一次。' }),
  recovery: t({ en: 'Some saved content could not be restored. Please check the recovered draft before sending.', zh: '部分记录未能恢复，请检查找回的草稿后再发送。' }),
  storage: t({ en: 'This tab cannot save changes right now. Keep it open to retain this conversation.', zh: '当前标签页暂时无法保存更改，请保持页面打开以保留对话。' }),
  errors: {
    quota_exhausted: { title: t({ en: 'xue’s reply service is out of credits for now', zh: '小薛的回复服务额度暂时用完了' }), detail: t({ en: 'Your conversation is saved. Please come back after service is restored.', zh: '这次对话会保留，请在服务恢复后再来聊。' }) },
    authentication_failed: { title: t({ en: 'The model service is temporarily unavailable', zh: '模型服务暂时无法连接' }), detail: t({ en: 'Siyuan Xue needs to check the model service connection.', zh: '薛思远需要检查模型服务连接。' }) },
    rate_limited: { title: t({ en: 'Too many chats at once', zh: '现在聊天的人有点多' }), detail: t({ en: 'Wait a minute before sending another message.', zh: '请稍等一分钟再发送。' }) },
    context_limit: { title: t({ en: 'This conversation is full', zh: '这次对话已经很长了' }), detail: t({ en: 'Try a shorter message. To start fresh, close this tab and open the chat page in a new tab.', zh: '可以先缩短准备发送的消息。如需重新开始，请关闭此标签页，再用新标签页进入聊天页面。' }) },
    timeout: { title: t({ en: 'The reply took too long', zh: '这次回复等得有点久' }), detail: t({ en: 'What arrived is saved. You can try again when the connection is steadier.', zh: '已收到的内容会保留，网络稳定后可以再试一次。' }) },
    upstream_unavailable: { title: t({ en: 'xue could not finish that reply', zh: '小薛没能完成这次回复' }), detail: t({ en: 'What arrived is saved. You can try again in a moment.', zh: '已收到的内容会保留，可以稍后再试。' }) },
    interrupted: { title: t({ en: 'The reply was interrupted', zh: '回复中断了' }), detail: t({ en: 'What arrived is saved. You can try again.', zh: '已收到的内容会保留，可以再试一次。' }) },
    invalid_request: { title: t({ en: 'That message could not be sent', zh: '这条消息没能发出' }), detail: t({ en: 'Check the message and try sending it again.', zh: '请检查消息内容后重新发送。' }) },
    body_too_large: { title: t({ en: 'This conversation is too large', zh: '这次对话内容太多了' }), detail: t({ en: 'To start fresh, close this tab and open the chat page in a new tab.', zh: '如需重新开始，请关闭此标签页，再用新标签页进入聊天页面。' }) },
    stream_error: { title: t({ en: 'The reply was interrupted', zh: '回复中断了' }), detail: t({ en: 'What arrived is saved. You can try again.', zh: '已收到的内容会保留，可以再试一次。' }) },
  },
};
const prompts = [
  { label: t({ en: 'Meet Siyuan Xue', zh: '认识一下薛思远' }), text: t({ en: 'Tell me a little about Siyuan Xue.', zh: '给我介绍一下薛思远吧。' }) },
  { label: t({ en: 'Explore projects', zh: '看看做过什么' }), text: t({ en: 'What projects has Siyuan Xue been working on?', zh: '薛思远做过哪些有意思的项目？' }) },
  { label: t({ en: 'Find a good read', zh: '找篇文章读读' }), text: t({ en: 'Help me find something to read on this website.', zh: '帮我找找这个网站有什么值得读的文章。' }) },
  { label: t({ en: 'Just say hello', zh: '随便聊两句' }), text: t({ en: 'Hi, xue. Let’s chat about something fun.', zh: '嗨，小薛，我们随便聊点有趣的吧。' }) },
];
---
<Base title={copy.title} description={copy.intro} htmlClass="has-xue-chat">
  <ChatApp client:load copy={copy} prompts={prompts} locale={locale} />
</Base>
