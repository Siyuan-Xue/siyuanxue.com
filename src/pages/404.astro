---
import Base from '../layouts/Base.astro';
import { locale } from '../i18n/locale';
import { House } from '@lucide/astro';
const title = locale === 'en' ? 'Page not found' : '页面未找到';
---
<Base title={title} noindex><div class="container cc-narrow"><h1>{title}</h1><p>{locale === 'en' ? 'This page does not exist.' : '这个页面不存在。'}</p><a href="/" class="header-control-button" aria-label={locale === 'en' ? 'Back home' : '返回首页'} title={locale === 'en' ? 'Back home' : '返回首页'}><House size={20} stroke-width={1.8} aria-hidden="true" /></a></div></Base>
