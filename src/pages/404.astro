---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/locale';
import { site } from '../data/site';
import { House } from '@lucide/astro';
const backHome = t(site.ui.backHome);
---
<Base><div class="container cc-narrow"><h1 class="post-title">{t(site.ui.notFound)}</h1><p>{t(site.ui.notFoundDetail)}</p><a href="/" class="header-control-button" aria-label={backHome} title={backHome}><House size={20} stroke-width={1.8} aria-hidden="true" /></a></div></Base>
