---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GalleryContent from '../../components/GalleryContent.astro';
import { getGalleryPages, GALLERY_PREVIEW_SLUG } from '../../utils/galleries';

export async function getStaticPaths() {
 return (await getGalleryPages(import.meta.env.DEV)).map(({ slug, entry }) => ({ params: { slug }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'gallery'> }
const { entry } = Astro.props;
const { title, description, images, draft, preview, videos } = entry.data;
const first = images[0];
const cover = first.src.cover;
const shareImage = { src: cover.src, width: cover.width, height: cover.height, alt: first.alt };
const galleryImages = images.map(photo => ({ src: photo.src.src, width: photo.src.width, height: photo.src.height, alt: photo.alt, caption: photo.caption }));
const galleryVideos = videos.map(video => ({ src: video.src.src, poster: video.poster.cover.src, name: `${title} · ${video.label}`, description: video.caption, duration: video.duration, uploadDate: video.uploadDate }));
---
<Base title={title} description={description} noindex={import.meta.env.DEV || draft || preview || Astro.params.slug === GALLERY_PREVIEW_SLUG} shareImage={shareImage} galleryImages={galleryImages} galleryVideos={galleryVideos}>
 <div class="container cc-narrow"><GalleryContent {...entry.data} /></div>
</Base>
